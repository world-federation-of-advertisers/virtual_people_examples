module(
    name = "virtual-people-examples",
    repo_name = "wfa_virtual_people_examples",
)

# WFA registry modules.
bazel_dep(
    name = "common-cpp",
    version = "0.14.0",
    repo_name = "wfa_common_cpp",
)
bazel_dep(
    name = "virtual-people-common",
    version = "0.10.0",
    repo_name = "virtual_people_common",
)
bazel_dep(
    name = "virtual-people-core-serving",
    version = "0.6.0",
    repo_name = "virtual_people_core_serving",
)

# Bazel Central Registry modules used directly by this repository.
bazel_dep(
    name = "abseil-cpp",
    version = "20250814.0",
    repo_name = "com_google_absl",
)
bazel_dep(
    name = "glog",
    version = "0.6.0",
    repo_name = "com_github_google_glog",
)
bazel_dep(
    name = "googletest",
    version = "1.17.0",
    repo_name = "com_google_googletest",
)
bazel_dep(
    name = "protobuf",
    version = "33.1",
    repo_name = "com_google_protobuf",
)
bazel_dep(
    name = "rules_cc",
    version = "0.2.0",
)
